<TITLE ATOC="Y" AASSOCNOTE="D-0-1-0-0">회사분할 결정</TITLE>
<P></P>

<TABLE-GROUP ACLASS="RSL_SPL" ADELETETABLE="N">

<TABLE ACLASS="EXTRACTION" AFIXTABLE="Y" WIDTH="782" BORDER="1">

<COLGROUP>
<COL WIDTH="109"></COL>
<COL WIDTH="96"></COL>
<COL WIDTH="73"></COL>
